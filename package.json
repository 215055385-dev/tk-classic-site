    "seo:indexnow": "node scripts/submit-indexnow.mjs",
    "seo:baidu": "node scripts/submit-baidu.mjs",
    "seo:audit": "node scripts/audit-public-seo.mjs",
    "lint": "eslint . --ignore-pattern .next --ignore-pattern .vercel --ignore-pattern dist --ignore-pattern playwright-report --ignore-pattern test-results",
    "test": "node --test tests/rendered-html.test.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/cormorant-garamond": "^5.3.0",
