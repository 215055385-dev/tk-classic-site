  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "local:setup": "powershell -ExecutionPolicy Bypass -File scripts/local-setup.ps1",
    "local:start": "powershell -ExecutionPolicy Bypass -File scripts/local-start.ps1",
    "local:package": "powershell -ExecutionPolicy Bypass -File scripts/package-local.ps1",
