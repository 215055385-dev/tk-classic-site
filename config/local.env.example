# Copy this file to .env.local and fill the values from Vercel/Supabase.
# Never commit .env.local or share secret/service-role keys.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Pooled connection for the running Next.js server.
CMS_DATABASE_URL=
POSTGRES_PRISMA_URL=

# Direct connection for migrations and maintenance only.
CMS_DIRECT_URL=
POSTGRES_URL_NON_POOLING=

# Keep false unless a trusted corporate proxy replaces TLS certificates locally.
CMS_ALLOW_SELF_SIGNED_CERTIFICATE=false

RESEND_API_KEY=
INQUIRY_TO_EMAILS=bowie@tkclassic.com,leo@tkclassic.com
INQUIRY_FROM_EMAIL=TK Classic Website <website@portablecoffeemachine.com>
INQUIRY_CONFIRMATION_FROM_EMAIL=TK Classic Sales <website@portablecoffeemachine.com>

# Temporary compatibility values while Supabase Auth migration is completed.
ADMIN_DASHBOARD_PASSWORD_HASH=
